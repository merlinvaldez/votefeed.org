        <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
        var coll = document.getElementsByClassName("main-span");
        var i;

        for (i = 0; i < coll.length; i++) {
            coll[i].addEventListener("click", function() {
            this.classList.toggle("active");
            var indicator = this.children[1];
            var content = this.nextElementSibling;
            if (content.style.display === "none") {
                content.style.display = "block";
                indicator.outerHTML = "<i class='fa-solid fa-chevron-up' style='color: #006391;'></i>"
                this.setAttribute('aria-expanded', 'true')
            } else {
                content.style.display = "none";
                indicator.outerHTML = "<i class='fa-solid fa-chevron-down' style='color: #006391;'></i>"
                this.setAttribute('aria-expanded', 'false')
            }
            });
            coll[i].addEventListener("keydown", function(e) {
            if(e.key === 'Enter' || e.key ==='Space'){
                this.classList.toggle("active");
                var indicator = this.children[1];
                var content = this.nextElementSibling;
                indicator.ariaExpanded = indicator.ariaExpanded !== 'true';
                if (content.style.display === "none") {
                    content.style.display = "block";
                    indicator.outerHTML = "<i class='fa-solid fa-chevron-up' style='color: #006391;'></i>"
                    this.setAttribute('aria-expanded', 'true')
                } else {
                    content.style.display = "none";
                    indicator.outerHTML = "<i class='fa-solid fa-chevron-down' style='color: #006391;'></i>"
                    this.setAttribute('aria-expanded', 'false')
                }
            }
            });  
        }
        </script>
