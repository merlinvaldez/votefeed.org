            function checkElement(id, value, pos) {
                let element = jQuery("#metl-2941").find(id);
                if (element.length && true) {
                    if (element.attr('type') == 'radio' || element.attr('type') == 'checkbox') {
                        jQuery("#metl-2941").find(`[value="` + value + `"]`).prop('checked', true);
                        element.prop('required', false)
                    } else if (element.length > 1 && element.attr('type') == 'text' && element.attr('name').endsWith('[]')) {
                        element[pos].value = value;
                    } else {
                        element.val(value);
