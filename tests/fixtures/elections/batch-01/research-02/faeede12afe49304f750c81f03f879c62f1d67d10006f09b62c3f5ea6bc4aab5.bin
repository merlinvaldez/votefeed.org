                        dtable.search(jQuery("#metl-2941 .dataTables_filter input").val()).draw();
                    })
                jQuery("#metl-2941 .dataTables_filter input")
                    .unbind()
                    .bind("keyup", function (e) {
                        if (e.keyCode == 13) {
                            dtable.search(this.value).draw();
                        }
                        if (this.value == "") {
                            dtable.search("").draw();
                        }
                        return;
                    });
            }

            if (dtData.buttons && dtData.buttons.length) {
                dtData.buttons[0]['action'] = newexportaction;
