            jQuery("#metl-2941-resultTable_filter").append('<button type="button" style="padding: 5px;vertical-align: middle;">Search</button>');
            jQuery(document).on('change', ' :checkbox[required]', function () {
                let oth = jQuery(this).parents('#form-metl-2941 .checkbox-group');
                let valid = oth.find(':checkbox[required]:checked').length;
                oth.find(':checkbox[required]').prop('required', valid === 0);
                oth.find(':checkbox[required]:checked').prop('checked', true);
            })
            jQuery(document).on('change', '#form-metl-2941 :checkbox', function () {
                jQuery(this).attr('checked', 'checked');
            })

            function getData() {
                var finalObj = {};
                jQuery.each(jQuery('#form-metl-2941').serializeArray(), function () {
                    if (this.value != 'Select One') {
                        if (finalObj[this.name]) {
                            let v = finalObj[this.name];
                            if (typeof v === 'string') {
                                finalObj[this.name] = [];
                                finalObj[this.name].push(v);
                            }
                            finalObj[this.name].push(this.value);
                        } else {
                            finalObj[this.name] = this.value;
                        }
                    }
                });
                finalObj["postID"] = '2941';
                return finalObj;
            }

                            dtable.ajax.url('/wp-json/metl/v1/all').load()
