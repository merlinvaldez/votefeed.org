<script type="text/javascript">
    function onKeyPressContest(sender, event) {
        if (event.keyCode == 13) {

            var masterTable = $find("ctl00_cphFooter_rdgSearch").get_masterTableView();
            masterTable.filter("Contests", sender.value, "Contains");
        }
       
    }
     function onKeyPressName(sender, event) {
        if (event.keyCode == 13) {

            var masterTable = $find("ctl00_cphFooter_rdgSearch").get_masterTableView();
            masterTable.filter("Name", sender.value, "Contains");
        }
       
     }
    function onKeyPressParty(sender, event) {
        if (event.keyCode == 13) {

            var masterTable = $find("ctl00_cphFooter_rdgSearch").get_masterTableView();
            masterTable.filter("Party", sender.value, "Contains");
        }
       
    }
    function onKeyPressLegalName(sender, event) {
        if (event.keyCode == 13) {

            var masterTable = $find("ctl00_cphFooter_rdgSearch").get_masterTableView();
            masterTable.filter("LegalName", sender.value, "Contains");
            }

    }
    function onKeyPressStatus(sender, event) {
        if (event.keyCode == 13) {

            var masterTable = $find("ctl00_cphFooter_rdgSearch").get_masterTableView();
                masterTable.filter("Status", sender.value, "Contains");
            }

        }
   
</script>

 
       

